rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function verified(uid) {
      return request.auth != null && request.auth.uid == uid
        && 'account_session' in request.auth.token
        && request.auth.token.account_session is string
        && get(/databases/$(database)/documents/_accountSessions/$(request.auth.token.account_session)).data.uid == uid
        && get(/databases/$(database)/documents/_accountSessions/$(request.auth.token.account_session)).data.revoked == false
        && request.time < timestamp.value(get(/databases/$(database)/documents/_accountSessions/$(request.auth.token.account_session)).data.expiresAt);
    }
    match /players/{uid} {
      allow read: if verified(uid);
      allow create, delete: if false;
      allow update: if verified(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'photoURL', 'updatedAt'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 40
        && request.resource.data.photoURL is string
        && request.resource.data.photoURL.size() <= 2048;
    }
    match /_accountSessions/{id} { allow read, write: if false; }
    match /_accountChallenges/{id} { allow read, write: if false; }
    match /gameIds/{id} { allow read, write: if false; }
  }
}
